---
// Silueta de PhyloPic como máscara CSS: toma el color del texto (currentColor).
import { silhouetteOf } from '../lib/site.js';
interface Props { id: string; class?: string; label?: string; style?: string }
const { id, class: cls = '', label, style = '' } = Astro.props;
const sil = silhouetteOf(id);
---
{sil
  ? <span class={`sil ${cls}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}
      style={`--src:url('${sil.file}');--aspect:${sil.aspect};${style}`}></span>
  : <span class={`sil-fallback ${cls}`} aria-hidden="true" style={style}>✦</span>}
