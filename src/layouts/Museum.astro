---
import '../styles/global.css';
import { stamps } from '../data/quiz.js';
import { ogIdFor } from '../data/og.js';
import { tr, L, stripLang } from '../i18n.js';
interface Props { title: string; description?: string; stamp?: string }
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const T = tr(lang);
const { title, description = T('Un museo de historia natural en tu navegador: 4,567 millones de años de vida, rocas y mundos desaparecidos, con fuentes y niveles de certeza.', 'A natural history museum in your browser: 4,567 million years of life, rocks and vanished worlds, with sources and levels of certainty.'), stamp } = Astro.props;
const base = stripLang(Astro.url.pathname);
const path = base.replace(/\/$/, '') || '/';
const links = [
  ['/tiempo', T('Tiempo', 'Time')], ['/vida', T('Archivo', 'Archive')], ['/dinosaurios', T('Dinosaurios', 'Dinosaurs')],
  ['/mexico', T('México', 'Mexico')], ['/donde-vives', T('Tu lugar', 'Your place')], ['/mitos', T('Mitos', 'Myths')], ['/metodo', T('Cómo sabemos', 'How we know')],
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const altEs = new URL(base, Astro.site), altEn = new URL(L('en', base === '/' ? '/' : base.replace(/\/$/, '')), Astro.site);
const ogImage = new URL(`/og/${lang === 'en' ? 'en-' : ''}${ogIdFor(base)}.jpg`, Astro.site);
// Analítica de Vercel: solo en compilaciones de Vercel (activarla en el panel del proyecto).
const analytics = !!process.env.VERCEL;
const fullTitle = title === 'Paleopulso' ? T('Paleopulso — Museo de la Tierra antes de nosotros', 'Paleopulso — A museum of the Earth before us') : `${title} · Paleopulso`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0e0b08" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={altEs} />
  <link rel="alternate" hreflang="en" href={altEn} />
  <link rel="alternate" hreflang="x-default" href={altEs} />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={T('es_MX', 'en_US')} />
  <meta property="og:site_name" content="Paleopulso" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {analytics && <script defer src="/_vercel/insights/script.js"></script>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{fullTitle}</title>
</head>
<body data-stamp={stamp}>
  <a class="skip" href="#contenido">{T('Saltar al contenido', 'Skip to content')}</a>
  <header class="site-nav">
    <div class="wrap">
      <a class="brand" href={L(lang, '/')} aria-label={T('Paleopulso, vestíbulo', 'Paleopulso, entrance hall')}>
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="16" cy="16" r="14" /><path d="M16 4c-4 4-4 8 0 12s4 8 0 12M8 9c5 2 11 2 16 0M7 16h18M8 23c5-2 11-2 16 0" opacity=".7" />
        </svg>
        Paleopulso
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navLinks">{T('Salas', 'Halls')}</button>
      <nav class="nav-links" id="navLinks" aria-label={T('Salas del museo', 'Museum halls')}>
        {links.map(([h, l]) => <a href={L(lang, h)} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}
      </nav>
      <a class="lang-switch" href={lang === 'en' ? altEs.pathname : altEn.pathname} hreflang={lang === 'en' ? 'es' : 'en'} lang={lang === 'en' ? 'es' : 'en'}
        title={T('Read in English', 'Leer en español')}>{lang === 'en' ? 'ES' : 'EN'}</a>
      <button class="sound-btn" type="button" id="soundBtn" aria-pressed="false"
        data-on={T('Apagar sonido ambiente', 'Turn ambient sound off')} data-off={T('Encender sonido ambiente', 'Turn ambient sound on')}
        aria-label={T('Encender sonido ambiente', 'Turn ambient sound on')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" /><path class="wave" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
      </button>
      <a class="passport-chip" href={L(lang, '/pasaporte')} title={T('Tu pasaporte del museo', 'Your museum passport')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2" /><circle cx="12" cy="10" r="3.2" /><path d="M8 17h8" /></svg>
        <span><span data-stamp-count>0</span>/{stamps.length}</span>
      </a>
    </div>
  </header>

  <main id="contenido"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div>
        <a class="brand" href={L(lang, '/')}>Paleopulso</a>
        <p style="margin-top:1rem">{T('Un museo hecho para quienes sienten curiosidad por haber llegado tan tarde. Las fechas siguen la Tabla Cronoestratigráfica Internacional; las reconstrucciones se marcan como interpretaciones.', 'A museum for anyone curious about having arrived so late. Dates follow the International Chronostratigraphic Chart; reconstructions are labelled as interpretations.')}</p>
        <p class="made">{T('Hecho en México.', 'Made in Mexico.')}</p>
      </div>
      <ul aria-label={T('Salas', 'Halls')}>
        <li><a href={L(lang, '/visita')}>{T('Visita guiada', 'Guided tour')}</a></li><li><a href={L(lang, '/tiempo')}>{T('Tiempo profundo', 'Deep time')}</a></li><li><a href={L(lang, '/continentes')}>{T('Máquina del tiempo', 'Time machine')}</a></li><li><a href={L(lang, '/vida')}>{T('Archivo de vida', 'Archive of life')}</a></li>
        <li><a href={L(lang, '/dinosaurios')}>{T('Sala mesozoica', 'Mesozoic hall')}</a></li><li><a href={L(lang, '/mexico')}>{T('Sala México', 'Mexico hall')}</a></li><li><a href={L(lang, '/donde-vives')}>{T('¿Qué había donde vives?', 'What was where you live?')}</a></li>
        <li><a href={L(lang, '/mitos')}>{T('Mitos y evidencia', 'Myths & evidence')}</a></li><li><a href={L(lang, '/metodo')}>{T('Cómo sabemos', 'How we know')}</a></li>
      </ul>
      <ul aria-label={T('Fuentes', 'Sources')}>
        <li><a href={L(lang, '/colabora')}>{T('Colabora y corrige', 'Contribute & correct')}</a></li>
        <li><a href={L(lang, '/creditos')}>{T('Créditos e imágenes', 'Credits & images')}</a></li>
        <li><a href="https://stratigraphy.org/chart" rel="noopener">{T('Escala ICS', 'ICS chart')}</a></li>
        <li><a href="https://paleobiodb.org" rel="noopener">Paleobiology Database</a></li>
        <li><a href="https://www.phylopic.org" rel="noopener">PhyloPic</a> · <a href="https://www.gplates.org" rel="noopener">GPlates</a></li>
      </ul>
    </div>
  </footer>

  <script>
    import { stamps } from '../data/quiz.js';
    import { setupAmbient } from '../scripts/ambient';
    setupAmbient(document.getElementById('soundBtn') as HTMLButtonElement);
    // Pasaporte: sella la sala actual y actualiza el contador.
    const KEY = 'paleopulso:stamps';
    const got = new Set<string>(JSON.parse(localStorage.getItem(KEY) || '[]'));
    const here = document.body.dataset.stamp;
    if (here && !got.has(here)) { got.add(here); localStorage.setItem(KEY, JSON.stringify([...got])); }
    const valid = [...got].filter((id) => stamps.some((s) => s.id === id));
    document.querySelectorAll('[data-stamp-count]').forEach((el) => (el.textContent = String(valid.length)));

    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.getElementById('navLinks');
    toggle?.addEventListener('click', () => {
      const open = nav!.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Entradas suaves.
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
