---
import Museum from '../layouts/Museum.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import { species, scaleRefs } from '../data/species.js';
import { periodById } from '../data/periods.js';
import { silhouetteOf } from '../lib/site.js';

const isDino = (s: any) => s.group === 'Dinosaurio' || s.group === 'Ave primitiva';
const rooms = ['triasico', 'jurasico', 'cretacico'].map((id) => ({
  p: periodById[id],
  list: species.filter((s) => s.period === id && s.id !== 'chicxulub').sort((a, b) => b.ma - a.ma),
}));
const comparable = [
  ...scaleRefs.map((r) => ({ id: r.id, name: r.name, length: r.length, note: r.note, ref: true })),
  ...species.filter((s) => s.length && silhouetteOf(s.id)).sort((a, b) => b.length! - a.length!)
    .map((s) => ({ id: s.id, name: s.name, length: s.length, note: s.lengthNote, ref: false })),
].map((c) => {
  const sil = silhouetteOf(c.id);
  return { ...c, file: sil?.file, aspect: sil?.aspect };
});
const defaults = ['humano', 'trex', 'argentinosaurus', 'autobus'];
const dinoCount = species.filter(isDino).length;
---
<Museum title="Sala mesozoica" stamp="dinosaurios" description="Dinosaurios del Triásico, Jurásico y Cretácico de todo el mundo, y un comparador de tamaños a escala real.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Sala III · Mesozoico · 252–66 Ma</p>
      <h1>Hueso, hipótesis<br /><em>y animal.</em></h1>
      <p class="lead">{dinoCount} dinosaurios de cinco continentes, junto a los reptiles que compartieron con ellos el aire y el mar. Cada ficha distingue el fósil, el montaje de museo y la reconstrucción en vida.</p>
    </div>
  </section>

  <section class="section compare-section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="kicker">Comparador a escala</p><h2>¿Qué tan grande<br /><em>era de verdad?</em></h2></div>
        <p>Elige hasta cinco. Todo está a la misma escala, en metros. La longitud es de hocico a cola (envergadura en voladores); en muchos casos es una estimación.</p>
      </div>
      <div class="compare vitrine">
        <div id="scaleOut" class="scale-out"></div>
      </div>
      <div class="picker" role="group" aria-label="Elegir animales para comparar">
        {comparable.map((c) => (
          <button type="button" class={`chip pick ${c.ref ? 'ref' : ''}`} data-pick={c.id} aria-pressed={defaults.includes(c.id) ? 'true' : 'false'} title={c.note}>{c.name}</button>
        ))}
      </div>
      <p class="label" id="pickNote" aria-live="polite"></p>
    </div>
  </section>

  {rooms.map(({ p, list }) => (
    <section class="section room" id={p.id} style={`--pc:${p.color}`}>
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <p class="kicker">{p.name} · {p.start}–{p.end} Ma</p>
            <h2>{p.lead}</h2>
          </div>
          <p>{p.world}</p>
        </div>
        <div class="specimen-grid">
          {list.map((s) => (
            <div class="room-cell reveal">
              <SpecimenCard s={s} />
              {!isDino(s) && <span class="not-dino">No es dinosaurio · {s.group}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap kpg reveal">
      <div>
        <p class="kicker">66 millones de años</p>
        <h2>El último día<br /><em>del Mesozoico.</em></h2>
      </div>
      <div>
        <p class="lead">Un asteroide de unos 10 km cayó en el mar somero de lo que hoy es Yucatán. En minutos hubo sismos y tsunamis; en horas, incendios; durante años, un cielo oscurecido por polvo y azufre que frenó la fotosíntesis.</p>
        <p class="muted">Sobrevivieron animales pequeños que podían refugiarse o comer semillas y detritos: entre ellos, los antepasados de las aves, que son los dinosaurios que siguen vivos.</p>
        <a class="btn" href="/especie/chicxulub">Ver el cráter de Chicxulub →</a>
      </div>
    </div>
  </section>
</Museum>

<script type="application/json" id="cmpData" set:html={JSON.stringify(comparable)} />
<script>
  import { scaleSvg } from '../scripts/scale';
  const items: any[] = JSON.parse(document.getElementById('cmpData')!.textContent!);
  const byId = Object.fromEntries(items.map((i) => [i.id, i]));
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const out = document.getElementById('scaleOut')!;
  const note = document.getElementById('pickNote')!;
  const MAX = 5;

  function render() {
    const sel = btns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => byId[b.dataset.pick!]);
    if (!sel.length) { out.innerHTML = '<p class="empty">Elige al menos una pieza.</p>'; return; }
    // Persona primero, luego de menor a mayor.
    sel.sort((a, b) => (a.id === 'humano' ? -1 : b.id === 'humano' ? 1 : a.length - b.length));
    out.innerHTML = scaleSvg(sel.map((s, i) => s.id === 'autobus'
      ? { length: 12, rect: { h: 3.2 }, label: 'Autobús' }
      : { file: s.file, aspect: s.aspect, length: s.length, label: s.name, tone: s.id === 'humano' ? 'human' : i % 2 ? 'alt' : 'animal' }));
    note.textContent = sel.map((s) => `${s.name}: ${s.note}`).join(' · ');
  }
  btns.forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') === 'true';
    const count = btns.filter((x) => x.getAttribute('aria-pressed') === 'true').length;
    if (!on && count >= MAX) { note.textContent = `Máximo ${MAX} a la vez: quita uno primero.`; return; }
    b.setAttribute('aria-pressed', String(!on));
    render();
  }));
  render();
</script>

<style>
  .compare { padding: 2.5rem 2rem 1.5rem; min-height: 320px; display: grid; align-items: end; }
  .scale-out :global(.empty) { text-align: center; color: var(--muted); }
  .picker { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.4rem 0 .8rem; max-height: 220px; overflow: auto; padding: .2rem; }
  .pick.ref { border-style: dashed; }
  #pickNote { line-height: 1.6; }
  .room { background: linear-gradient(180deg, color-mix(in srgb, var(--pc) 9%, transparent), transparent 40%); }
  .room .kicker { color: color-mix(in srgb, var(--pc) 70%, var(--brass)); }
  .room h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); }
  .room-cell { position: relative; }
  .room-cell :global(.specimen) { height: 100%; }
  .not-dino { position: absolute; top: .7rem; left: .7rem; z-index: 4; font: 600 .66rem var(--label); letter-spacing: .12em; text-transform: uppercase; background: #0e0b08e6; color: var(--sky); border: 1px solid #7fb0b555; padding: .25rem .5rem; border-radius: 3px; }
  .kpg { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: center; }
  .kpg h2 { color: var(--rust); }
  .kpg .btn { margin-top: 1rem; }
  @media (max-width: 860px) { .kpg { grid-template-columns: 1fr; } }
</style>
