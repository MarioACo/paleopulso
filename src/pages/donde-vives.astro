---
import Museum from '../layouts/Museum.astro';
import { periods, formatMa, clockTime } from '../data/periods.js';
import { species } from '../data/species.js';
import { assets, paleoOf, href } from '../lib/site.js';

// Momentos del viaje: un mapa por periodo (los que GPlates puede reconstruir).
const stops = periods.filter((p) => p.map !== null && p.rank === 'Periodo' || p.id === 'proterozoico')
  .map((p) => ({ id: p.id, name: p.name, color: p.color, time: p.map, url: assets.maps?.[p.map], lead: p.lead, clock: clockTime(p.map) }))
  .sort((a, b) => b.time - a.time);
// Fósiles de la colección en su posición antigua, agrupados por periodo.
const fossils = Object.fromEntries(stops.map((st) => [st.id, species.filter((s) => s.period === st.id && paleoOf(s.id))
  .map((s) => ({ id: s.id, name: s.name, href: href(s), mx: s.mexico, lon: paleoOf(s.id)!.lon, lat: paleoOf(s.id)!.lat }))]));
const collection = species.map((s) => ({ id: s.id, name: s.name, href: href(s), lat: s.lat, lon: s.lon, place: `${s.place}, ${s.country}`, age: formatMa(s.ma) }));
const quick = [
  ['Ciudad de México', 19.43, -99.13], ['Monterrey', 25.67, -100.31], ['Guadalajara', 20.67, -103.35], ['Saltillo', 25.42, -101.0],
  ['Mérida', 20.97, -89.62], ['Tijuana', 32.51, -117.04], ['Oaxaca', 17.06, -96.72], ['Bogotá', 4.71, -74.07],
  ['Buenos Aires', -34.6, -58.38], ['Madrid', 40.42, -3.7], ['Nueva York', 40.71, -74.01], ['Tokio', 35.68, 139.69],
];
---
<Museum title="¿Qué había donde vives?" stamp="donde" description="Elige tu ciudad y viaja en el tiempo: dónde estaba ese punto del planeta hace 66, 150 o 500 millones de años.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Tu lugar en el tiempo</p>
      <h1>¿Qué había<br /><em>donde vives?</em></h1>
      <p class="lead">El suelo que pisas ha viajado miles de kilómetros. Elige un lugar y te mostramos dónde estaba en cada época, qué latitud tenía y qué fósiles de la colección vivieron cerca.</p>
    </div>
  </section>

  <section class="wrap finder">
    <form class="search" id="search" role="search">
      <label for="place" class="label">Busca un lugar</label>
      <div class="row">
        <input id="place" type="search" placeholder="Tu ciudad, pueblo o colonia…" autocomplete="off" required />
        <button class="btn" type="submit">Viajar</button>
        <button class="btn ghost" type="button" id="geo">Usar mi ubicación</button>
      </div>
      <div class="quick" role="group" aria-label="Lugares de ejemplo">
        {quick.map(([n, la, lo]) => <button type="button" class="chip" data-lat={la} data-lon={lo} data-name={n}>{n}</button>)}
      </div>
      <p class="status" id="status" aria-live="polite"></p>
    </form>

    <div class="journey" id="journey" hidden>
      <div class="here">
        <p class="label">Tu punto de partida</p>
        <h2 id="hereName"></h2>
        <p class="muted" id="hereCoord"></p>
      </div>

      <div class="timeline" role="tablist" aria-label="Épocas">
        {stops.map((st, i) => (
          <button type="button" role="tab" class="stop" data-stop={st.id} style={`--c:${st.color}`} aria-selected={st.id === 'cretacico' ? 'true' : 'false'}>
            <span class="num">{st.time} Ma</span><strong>{st.name}</strong>
          </button>
        ))}
      </div>

      <div class="view">
        <div class="vitrine map-box"><svg id="paleo" aria-label="Mapa de la época con tu punto"></svg></div>
        <aside class="cedula reading" aria-live="polite">
          <div class="ced-no"><span id="rPeriod"></span><span id="rClock"></span></div>
          <h3 id="rTitle"></h3>
          <p id="rLead" class="sci"></p>
          <p id="rText"></p>
          <p id="rMoved"></p>
          <div id="rFossils"></div>
        </aside>
      </div>
      <p class="note">Las siluetas de tierra son los continentes actuales desplazados por el modelo de placas MERDITH2021 (GPlates). El nivel del mar antiguo era distinto, así que el mapa no indica si tu punto era tierra firme o fondo marino. Cada fósil aparece en la posición que tenía en su propia edad, que puede diferir unos millones de años de la del mapa.</p>

      <div class="near">
        <p class="kicker">Lo más cercano de la colección</p>
        <div class="near-list" id="near"></div>
      </div>
    </div>
    <p class="privacy">Privacidad: tus coordenadas se redondean a 0.1° (unos 10 km) y se envían solo a GPlates para el cálculo; las búsquedas por nombre usan OpenStreetMap Nominatim. Nada se guarda.</p>
  </section>
</Museum>

<script type="application/json" id="dvData" set:html={JSON.stringify({ stops, fossils, collection })} />
<script>
  import { drawMap } from '../scripts/map';
  const { stops, fossils, collection } = JSON.parse(document.getElementById('dvData')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const status = $('status');
  let here: { lat: number; lon: number; name: string } | null = null;
  let paleo: Record<number, { lat: number; lon: number } | null> = {};
  let current = 'cretacico';

  const fmtCoord = (lat: number, lon: number) => `${Math.abs(lat).toFixed(1)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lon).toFixed(1)}° ${lon >= 0 ? 'E' : 'O'}`;
  const km = (a: any, b: any) => {
    const r = Math.PI / 180, dLat = (b.lat - a.lat) * r, dLon = (b.lon - a.lon) * r;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLon / 2) ** 2;
    return Math.round(2 * 6371 * Math.asin(Math.sqrt(h)));
  };
  const belt = (lat: number) => {
    const a = Math.abs(lat);
    return a < 23.5 ? 'dentro del trópico, cerca del ecuador' : a < 35 ? 'en latitudes subtropicales' : a < 55 ? 'en latitudes templadas' : a < 66.5 ? 'en latitudes frías' : 'en la región polar';
  };
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function reconstruct(lat: number, lon: number) {
    paleo = {};
    const times = stops.map((s: any) => s.time);
    let done = 0;
    status.textContent = 'Moviendo las placas tectónicas…';
    // De tres en tres para no saturar el servicio.
    for (let i = 0; i < times.length; i += 3) {
      await Promise.all(times.slice(i, i + 3).map(async (t: number) => {
        try {
          const r = await fetch(`https://gws.gplates.org/reconstruct/reconstruct_points/?points=${lon},${lat}&time=${t}&model=MERDITH2021`);
          const c = (await r.json())?.coordinates?.[0];
          // 1000,1000 = el punto no pertenece a ninguna placa del modelo en esa edad.
          paleo[t] = c && Math.abs(c[1]) <= 90 && Math.abs(c[0]) <= 180 ? { lon: c[0], lat: c[1] } : null;
        } catch { paleo[t] = null; }
        status.textContent = `Moviendo las placas tectónicas… ${++done}/${times.length}`;
      }));
    }
  }

  async function go(lat: number, lon: number, name: string) {
    lat = Math.round(lat * 10) / 10; lon = Math.round(lon * 10) / 10;
    here = { lat, lon, name };
    await reconstruct(lat, lon);
    if (Object.values(paleo).every((v) => v === null)) {
      status.textContent = 'No pudimos contactar al servicio de reconstrucción. Intenta de nuevo en un momento.';
      return;
    }
    status.textContent = '';
    $('journey').hidden = false;
    $('hereName').textContent = name;
    $('hereCoord').textContent = fmtCoord(lat, lon);
    nearest();
    await show(current);
    $('journey').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function show(id: string) {
    current = id;
    const st = stops.find((s: any) => s.id === id);
    document.querySelectorAll<HTMLElement>('[data-stop]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.stop === id)));
    const p = paleo[st.time];
    const sites = (fossils[id] || []).map((f: any) => ({ ...f, label: f.name, ping: false }));
    if (p) sites.push({ id: 'you', lat: p.lat, lon: p.lon, label: 'Tú', you: true });
    await drawMap($('paleo') as unknown as SVGSVGElement, { url: st.url, sites, width: 900, height: 460 });
    $('rPeriod').textContent = `${st.name} · hace ${st.time} Ma`;
    $('rClock').textContent = `${st.clock} en el día de la Tierra`;
    $('rTitle').textContent = p ? `${here!.name} estaba en ${fmtCoord(p.lat, p.lon)}` : `${here!.name}: sin reconstrucción`;
    $('rLead').textContent = st.lead;
    $('rText').textContent = p
      ? `Es decir, ${belt(p.lat)}${p.lat * here!.lat < 0 ? ', y en el otro hemisferio' : ''}. La latitud no lo dice todo: en épocas cálidas como el Cretácico no había hielo ni en los polos.`
      : 'El modelo de placas no asigna este punto a ninguna placa en esa época (suele pasar con terrenos que se unieron al continente después).';
    $('rMoved').innerHTML = p ? `<b>${km(here!, p).toLocaleString('es-MX')} km</b> entre aquel lugar y el actual.` : '';
    const list = fossils[id] || [];
    $('rFossils').innerHTML = list.length
      ? `<p class="label">En el mapa, de la colección:</p><p>${list.map((f: any) => `<a href="${f.href}">${esc(f.name)}</a>`).join(' · ')}</p>`
      : '';
  }

  function nearest() {
    const list = collection.map((s: any) => ({ ...s, d: km(here!, s) })).sort((a: any, b: any) => a.d - b.d).slice(0, 4);
    $('near').innerHTML = list.map((s: any) => `<a class="near-item" href="${s.href}"><strong>${esc(s.name)}</strong><span>${esc(s.place)}</span><span class="label">${s.d.toLocaleString('es-MX')} km · ${esc(s.age)}</span></a>`).join('');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', () => here && show(b.dataset.stop!)));
  document.querySelectorAll<HTMLButtonElement>('.quick [data-lat]').forEach((b) => b.addEventListener('click', () => go(+b.dataset.lat!, +b.dataset.lon!, b.dataset.name!)));

  $('search').addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = ($('place') as HTMLInputElement).value.trim();
    if (!q) return;
    status.textContent = 'Buscando el lugar…';
    try {
      const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&accept-language=es&q=${encodeURIComponent(q)}`);
      const [hit] = await r.json();
      if (!hit) { status.textContent = 'No encontramos ese lugar. Prueba con la ciudad y el país.'; return; }
      go(+hit.lat, +hit.lon, hit.display_name.split(',').slice(0, 2).join(','));
    } catch { status.textContent = 'La búsqueda no respondió. Prueba con uno de los lugares de ejemplo.'; }
  });

  $('geo').addEventListener('click', () => {
    if (!navigator.geolocation) { status.textContent = 'Tu navegador no permite compartir la ubicación.'; return; }
    status.textContent = 'Pidiendo tu ubicación…';
    navigator.geolocation.getCurrentPosition(
      (pos) => go(pos.coords.latitude, pos.coords.longitude, 'Tu ubicación'),
      () => { status.textContent = 'No se pudo obtener tu ubicación. Puedes escribir tu ciudad.'; },
      { timeout: 10000, maximumAge: 600000 },
    );
  });
</script>

<style>
  .finder { padding-bottom: 6rem; }
  .search { background: var(--wall); border: 1px solid var(--line); border-radius: 6px; padding: 1.6rem; display: grid; gap: .9rem; }
  .search .row { display: flex; gap: .6rem; flex-wrap: wrap; }
  .search input { flex: 1; min-width: 240px; font: inherit; color: var(--text); background: var(--night); border: 1px solid var(--line); border-radius: 4px; padding: .8rem 1rem; }
  .quick { display: flex; flex-wrap: wrap; gap: .4rem; }
  .status { margin: 0; color: var(--brass); min-height: 1.4em; font-size: .95rem; }
  .journey { margin-top: 3rem; scroll-margin-top: 80px; }
  .here h2 { font-size: clamp(2rem, 4vw, 3.2rem); margin: .3rem 0 .2rem; }
  .timeline { display: flex; gap: 2px; overflow-x: auto; margin: 2rem 0 1.4rem; padding-bottom: .4rem; scrollbar-width: thin; }
  .stop { flex: 1 0 96px; text-align: left; display: grid; gap: .1rem; background: var(--wall); border: 0; border-top: 4px solid color-mix(in srgb, var(--c) 60%, #000); padding: .7rem .7rem .8rem; transition: background .2s; }
  .stop:hover { background: var(--wall-2); }
  .stop[aria-selected='true'] { background: color-mix(in srgb, var(--c) 22%, var(--wall)); border-top-color: var(--c); }
  .stop .num { font-size: .95rem; color: var(--muted); }
  .stop strong { font: 400 1.1rem var(--serif); }
  .view { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.4rem; align-items: start; }
  .map-box { padding: .8rem; }
  .map-box :global(.you-halo) { transform-box: fill-box; transform-origin: center; }
  .reading h3 { font-size: 1.6rem; }
  .reading :global(a) { color: var(--ink); }
  .note { font-size: .8rem; color: var(--muted); margin-top: .8rem; max-width: 80ch; }
  .near { margin-top: 3rem; }
  .near-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .8rem; margin-top: 1rem; }
  .near-list :global(.near-item) { display: grid; gap: .2rem; padding: 1rem 1.1rem; background: var(--wall); border: 1px solid var(--line); border-radius: 6px; text-decoration: none; transition: border-color .2s; }
  .near-list :global(.near-item:hover) { border-color: var(--brass); }
  .near-list :global(strong) { font: 400 1.3rem var(--serif); }
  .near-list :global(span) { color: var(--muted); font-size: .88rem; }
  .privacy { font-size: .78rem; color: var(--muted); margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  @media (max-width: 900px) { .view { grid-template-columns: 1fr; } }
</style>
