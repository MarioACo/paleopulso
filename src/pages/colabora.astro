---
import Museum from '../layouts/Museum.astro';
import { species } from '../data/species.js';
import { assets, REPO, issueUrl } from '../lib/site.js';
const studies = Object.values(assets.refs || {}).reduce((n: number, r: any) => n + r.studies.length, 0);
const ways = [
  { t: 'Corrige un dato', d: 'Si una fecha, un tamaño o una afirmación no es correcta, dinos qué dice, qué debería decir y, si puedes, la fuente.', href: issueUrl('correccion.yml', '[Corrección] '), cta: 'Reportar una corrección' },
  { t: 'Propón una pieza', d: 'Falta tu fósil favorito, un yacimiento de tu país o un descubrimiento reciente. Cuéntanos nombre, época y lugar.', href: issueUrl('sugerencia.yml', '[Sugerencia] Nueva pieza: ', { tipo: 'Nueva pieza para la colección' }), cta: 'Sugerir una pieza' },
  { t: 'Dinos qué es incómodo', d: 'Algo difícil de leer, lento en tu celular o confuso de usar. Indica tu dispositivo y navegador.', href: issueUrl('sugerencia.yml', '[Sugerencia] Uso: ', { tipo: 'Algo es difícil de usar o leer' }), cta: 'Reportar un problema de uso' },
  { t: 'Comparte imágenes', d: '¿Tienes fotos de fósiles o paleoarte propio? Si lo publicas con licencia libre (CC BY o CC0), podemos exhibirlo con tu nombre.', href: issueUrl('sugerencia.yml', '[Sugerencia] Imágenes: ', { tipo: 'Imágenes o fotos' }), cta: 'Ofrecer imágenes' },
];
---
<Museum title="Colabora" description="Ayuda a mejorar Paleopulso: corrige datos, propone piezas y cuéntanos qué es incómodo de usar.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Colabora</p>
      <h1>Un museo que se<br /><em>corrige en público.</em></h1>
      <p class="lead">Paleopulso es un proyecto independiente hecho en México. Cada dato está verificado contra fuentes ({species.length} piezas, {studies} estudios con DOI comprobado), pero la ciencia cambia y siempre se nos escapa algo. Si sabes de paleontología, geología o simplemente viste algo raro, tu ayuda vale mucho.</p>
    </div>
  </section>
  <section class="wrap ways">
    {ways.map((w) => (
      <article class="cedula">
        <h2>{w.t}</h2>
        <p>{w.d}</p>
        <a class="btn" href={w.href} rel="noopener">{w.cta} ↗</a>
      </article>
    ))}
  </section>
  <section class="wrap how">
    <h2>Cómo verificamos</h2>
    <ul>
      <li>Fechas de la escala geológica: Tabla Cronoestratigráfica Internacional (ICS).</li>
      <li>Edad de cada pieza: se compara automáticamente con su rango en la Paleobiology Database; las diferencias se documentan.</li>
      <li>Bibliografía: cada DOI se comprueba en Crossref (título, año y primer autor) antes de publicarse.</li>
      <li>Imágenes: solo licencias libres, con autoría en <a href="/creditos">Créditos</a>.</li>
      <li>Lo que está en discusión científica se marca como <span class="badge debate">En debate</span>.</li>
    </ul>
    <p class="muted">Los avisos se gestionan en <a href={`${REPO}/issues`} rel="noopener">GitHub</a> (necesitas una cuenta gratuita). El código es público: <a href={REPO} rel="noopener">{REPO.replace('https://', '')}</a>.</p>
  </section>
</Museum>
<style>
  .ways { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .ways h2 { font-size: 1.7rem; color: var(--ink); margin-bottom: .6rem; }
  .ways .btn { margin-top: .4rem; }
  .how { padding: 4rem 0 6rem; max-width: 760px; }
  .how h2 { font-size: 2rem; margin-bottom: 1rem; }
  .how ul { color: var(--muted); display: grid; gap: .5rem; }
  .how a { color: var(--brass); }
</style>
