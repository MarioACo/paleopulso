---
import Museum from '../../layouts/Museum.astro';
import Silhouette from '../../components/Silhouette.astro';
import { scaleSvg } from '../../scripts/scale';
import { species, scaleRefs } from '../../data/species.js';
import { formatMa, clockTime } from '../../data/periods.js';
import { assets, photosOf, mainPhoto, periodOf, paleoOf, pbdbOf, articleOf, silhouetteOf, silhouetteIsProxy, href, KIND_LABEL, KIND_NOTE, fmtLength } from '../../lib/site.js';

export function getStaticPaths() {
  return species.map((s) => ({ params: { id: s.id } }));
}
const { id } = Astro.params;
const s = species.find((x) => x.id === id)!;
const p = periodOf(s);
const photos = [...photosOf(s.id)].sort((a, b) => ['life', 'evidence', 'evidence2', 'lead'].indexOf(a.kind) - ['life', 'evidence', 'evidence2', 'lead'].indexOf(b.kind));
const paleo = paleoOf(s.id);
const pbdb = pbdbOf(s.id);
const sil = silhouetteOf(s.id);
const human = silhouetteOf('humano');
const chrono = [...species].sort((a, b) => b.ma - a.ma);
const i = chrono.findIndex((x) => x.id === s.id);
const prev = chrono[i - 1], next = chrono[i + 1];
const no = String(species.indexOf(s) + 1).padStart(3, '0');

// Distancia recorrida por la placa desde entonces (gran círculo).
function km(a: { lat: number; lon: number }, b: { lat: number; lon: number }) {
  const r = Math.PI / 180, dLat = (b.lat - a.lat) * r, dLon = (b.lon - a.lon) * r;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLon / 2) ** 2;
  return Math.round(2 * 6371 * Math.asin(Math.sqrt(h)));
}
const moved = paleo ? km(s, paleo) : null;
const fmtCoord = (lat: number, lon: number) => `${Math.abs(lat).toFixed(1)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lon).toFixed(1)}° ${lon >= 0 ? 'E' : 'O'}`;

// Escala con una persona de 1.70 m (o regla de 30 cm para piezas pequeñas).
const small = s.length !== null && s.length < 0.5;
const ruler = s.length !== null && s.length < 0.1 ? 0.1 : 0.3;
const hero = mainPhoto(s.id);
// Eje del bloque PBDB: abarca el periodo y el rango registrado.
const hi = pbdb ? +Math.max(p.start, pbdb.first).toFixed(1) : 0, lo = pbdb ? +Math.min(p.end, pbdb.last).toFixed(1) : 0;
const pos = (ma: number) => ((hi - ma) / (hi - lo || 1)) * 100;
---
<Museum title={s.name} stamp="vida" description={s.summary} image={hero?.file}>
  <article class="wrap ficha" style={`--pc:${p.color}`}>
    <nav class="crumbs label" aria-label="Ruta"><a href="/vida">Archivo de vida</a> › <a href={`/tiempo#${p.id}`}>{p.name}</a> › {s.name}</nav>

    <div class="top">
      <div class="gallery">
        <div class="vitrine stage">
          {photos.length ? photos.map((ph, k) => (
            <figure data-photo={k} hidden={k !== 0}>
              <img src={ph.file} alt={ph.label || s.name} width={ph.w} height={ph.h} loading={k ? 'lazy' : 'eager'} />
            </figure>
          )) : <div class="no-photo"><Silhouette id={s.id} class="big-sil" /><p class="label">Sin fotografía con licencia libre</p></div>}
          <div class="plinth"></div>
        </div>
        {photos.length > 1 && (
          <div class="tabs" role="tablist" aria-label="Vistas de la pieza">
            {photos.map((ph, k) => <button type="button" class="chip" role="tab" aria-selected={k === 0 ? 'true' : 'false'} aria-pressed={k === 0 ? 'true' : 'false'} data-tab={k}>{KIND_LABEL[ph.kind] || 'Vista'}{photos.filter((x) => x.kind === ph.kind).length > 1 ? ` ${photos.slice(0, k + 1).filter((x) => x.kind === ph.kind).length}` : ''}</button>)}
          </div>
        )}
        {photos.map((ph, k) => (
          <div class="caption" data-cap={k} hidden={k !== 0}>
            <p><span class={`tag tag-${ph.kind}`}>{KIND_LABEL[ph.kind]}</span> {ph.note || KIND_NOTE[ph.kind]}</p>
            <p class="credit">{ph.label && <>{ph.label} · </>}{ph.credit} · <a href={ph.licenseUrl || ph.source} rel="noopener">{ph.license}</a> · <a href={ph.source} rel="noopener">Wikimedia Commons ↗</a></p>
          </div>
        ))}
      </div>

      <aside class="cedula main-ced">
        <div class="ced-no"><span>Pieza {no}</span><span>{p.name}</span></div>
        <h1>{s.name}</h1>
        <p class="sci">{s.group} · {s.place}, {s.country}</p>
        <p>{s.summary}</p>
        <dl>
          <div><dt>Edad</dt><dd>{s.age}</dd></div>
          <div><dt>Tamaño</dt><dd>{s.lengthNote || '—'}</dd></div>
          <div><dt>Ambiente</dt><dd>{s.habitat}</dd></div>
          <div><dt>En el día de la Tierra</dt><dd>{clockTime(s.ma)}</dd></div>
        </dl>
        {s.debated && <p class="debate"><span class="badge debate">En debate</span> {s.debated}</p>}
      </aside>
    </div>

    <section class="fact reveal">
      <span class="label">¿Sabías que…?</span>
      <p>{s.fact}</p>
    </section>

    {s.length && sil && (
      <section class="block reveal">
        <div class="block-head"><p class="kicker">A escala</p><h2>{small ? `Frente a una regla de ${ruler * 100} cm` : 'Frente a una persona de 1.70 m'}</h2></div>
        <div class="scale">
          <Fragment set:html={scaleSvg([
            ...(small ? [{ length: ruler, rect: { h: ruler / 12 }, label: `Regla de ${ruler * 100} cm` }] : human ? [{ file: human.file, aspect: human.aspect, length: 1.7, tone: 'human' as const, label: 'Persona' }] : []),
            { file: sil.file, aspect: sil.aspect, length: s.length, label: s.name },
          ])} />
          <p class="note">Longitud de referencia: {s.lengthNote}. Silueta: {silhouetteOf(s.id)!.taxon}{silhouetteIsProxy(s) && ' (taxón emparentado; no hay silueta libre de esta especie)'}.</p>
        </div>
      </section>
    )}

    <section class="block reveal">
      <div class="block-head">
        <p class="kicker">Entonces y ahora</p>
        <h2>{paleo ? <>El lugar del hallazgo <em>se ha movido {moved!.toLocaleString('es-MX')} km</em></> : 'El lugar del hallazgo'}</h2>
        {paleo && <p class="muted">Hoy {s.place} está en {fmtCoord(s.lat, s.lon)}. Hace {paleo.time} Ma, según el modelo de placas, estaba en {fmtCoord(paleo.lat, paleo.lon)}.</p>}
      </div>
      <div class={`maps ${paleo ? '' : 'single'}`}>
        {paleo && <figure class="vitrine"><svg id="mapThen"></svg><figcaption class="label">Hace {paleo.time} Ma</figcaption></figure>}
        <figure class="vitrine"><svg id="mapNow"></svg><figcaption class="label">Hoy</figcaption></figure>
      </div>
      {!paleo && s.ma <= 1000 && <p class="note">El modelo de placas no asigna este punto a ninguna placa en esa época, así que no se muestra su posición antigua.</p>}
      {!paleo && s.ma > 1000 && <p class="note">De hace más de 1,000 Ma no hay reconstrucciones fiables de la posición de los continentes.</p>}
      <p class="note">Paleogeografía: GPlates Web Service, modelo MERDITH2021. Las costas antiguas son reconstrucciones aproximadas.</p>
    </section>

    {pbdb && (
      <section class="block reveal">
        <div class="block-head"><p class="kicker">En la base de datos</p><h2>Lo que registra la <em>Paleobiology Database</em></h2></div>
        <div class="pbdb">
          <div class="pbdb-bar">
            <span class="period" style={`left:${pos(p.start)}%;right:${100 - pos(p.end)}%`}><i>{p.name}</i></span>
            <span class="range" style={`left:${pos(pbdb.first)}%;right:${100 - pos(pbdb.last)}%`}></span>
          </div>
          <div class="pbdb-axis label"><span>{hi} Ma</span><span>{lo} Ma</span></div>
          <p class="note" style="margin:0 0 .8rem">Barra de color: el periodo. Línea dorada: el rango del taxón en PBDB.</p>
          <p>PBDB tiene <b>{pbdb.occurrences?.toLocaleString('es-MX') ?? '—'}</b> {pbdb.occurrences === 1 ? 'registro' : 'registros'} de <i>{pbdb.taxon}</i>, con primera aparición hacia <b>{pbdb.first} Ma</b> y última hacia <b>{pbdb.last} Ma</b>.
            {s.pbdbNote && <> {s.pbdbNote}</>}
          </p>
          <a class="btn ghost" href={pbdb.url} rel="noopener">Ver en PBDB ↗</a>
        </div>
      </section>
    )}

    <section class="block sources reveal">
      <p class="kicker">Para seguir leyendo</p>
      <ul>
        {articleOf(s.id) && <li><a href={articleOf(s.id)} rel="noopener">Artículo en Wikipedia ↗</a></li>}
        {sil && <li>Silueta: <a href={sil.page} rel="noopener">{sil.taxon}</a> por {sil.attribution || sil.contributor} · {sil.license} (PhyloPic)</li>}
      </ul>
    </section>

    <nav class="pager" aria-label="Piezas vecinas en el tiempo">
      {prev ? <a href={href(prev)}><span class="label">← Más antiguo</span><strong>{prev.name}</strong><small>{formatMa(prev.ma)}</small></a> : <span></span>}
      {next ? <a href={href(next)} class="right"><span class="label">Más reciente →</span><strong>{next.name}</strong><small>{formatMa(next.ma)}</small></a> : <span></span>}
    </nav>
  </article>
</Museum>

<script type="application/json" id="fichaData" set:html={JSON.stringify({
  now: { url: assets.maps?.[0], site: { id: s.id, lon: s.lon, lat: s.lat, label: s.place, mx: s.mexico, ping: true } },
  then: paleo ? { url: assets.maps?.[paleo.time], site: { id: s.id, lon: paleo.lon, lat: paleo.lat, label: s.name, mx: s.mexico, ping: true } } : null,
})} />
<script>
  import { drawMap } from '../../scripts/map';
  const d = JSON.parse(document.getElementById('fichaData')!.textContent!);
  const el = (id: string) => document.getElementById(id) as unknown as SVGSVGElement | null;
  if (el('mapNow')) drawMap(el('mapNow')!, { url: d.now.url, sites: [d.now.site], width: 640, height: 320 });
  if (d.then && el('mapThen')) drawMap(el('mapThen')!, { url: d.then.url, sites: [d.then.site], width: 640, height: 320 });

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.tab;
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => { x.setAttribute('aria-selected', String(x === b)); x.setAttribute('aria-pressed', String(x === b)); });
    document.querySelectorAll<HTMLElement>('[data-photo]').forEach((f) => (f.hidden = f.dataset.photo !== k));
    document.querySelectorAll<HTMLElement>('[data-cap]').forEach((f) => (f.hidden = f.dataset.cap !== k));
  }));
</script>

<style>
  .ficha { padding: 2rem 0 6rem; }
  .crumbs { margin-bottom: 1.5rem; }
  .crumbs a { color: var(--brass); text-decoration: none; }
  .top { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.5rem; align-items: start; }
  .stage { aspect-ratio: 4 / 3; position: relative; }
  .stage figure { margin: 0; position: absolute; inset: 0; padding: 1.4rem 1.4rem 2rem; }
  .stage figure[hidden] { display: none; }
  .stage img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 30px #000); }
  .no-photo { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 1rem; padding: 2rem; }
  .no-photo :global(.big-sil) { width: 70%; color: var(--paper); opacity: .85; }
  .tabs { display: flex; gap: .4rem; margin-top: .9rem; flex-wrap: wrap; }
  .caption { margin-top: .9rem; font-size: .9rem; color: var(--muted); }
  .caption p { margin: 0 0 .3rem; }
  .credit { font-size: .78rem; }
  .credit a { color: var(--brass); }
  .tag { font: 600 .68rem var(--label); letter-spacing: .14em; text-transform: uppercase; padding: .15rem .45rem; border-radius: 3px; background: var(--wall-2); color: var(--brass); margin-right: .3rem; }
  .tag-life { color: var(--sky); }
  .main-ced { position: sticky; top: 88px; }
  .main-ced h1 { font-size: clamp(2.2rem, 4vw, 3.4rem); color: var(--ink); margin: .6rem 0 .2rem; }
  .main-ced .sci { margin-bottom: 1rem; }
  .debate { margin-top: 1rem; font-size: .9rem; color: #3d3226; }
  .fact { margin: 4rem 0 2rem; padding: 2rem 2.4rem; border-left: 3px solid var(--brass); background: linear-gradient(90deg, rgba(209, 171, 98, .1), transparent); }
  .fact p { font: 400 clamp(1.3rem, 2.2vw, 1.8rem)/1.4 var(--serif); margin: .4rem 0 0; max-width: 46ch; }
  .block { margin-top: 4.5rem; }
  .block-head { margin-bottom: 1.6rem; max-width: 70ch; }
  .block-head h2 { font-size: clamp(1.8rem, 3.2vw, 2.6rem); margin-top: .5rem; }
  .block-head .muted { margin-top: .8rem; }
  .scale { background: var(--wall); border: 1px solid var(--line); border-radius: 6px; padding: 2rem 2rem 1rem; }
  .scale-stage { display: flex; align-items: flex-end; gap: 2%; min-height: 120px; border-bottom: 2px solid var(--brass-dim); padding-bottom: 2px; }
  .scale-stage .sil { flex: none; }
  .scale-human { color: var(--muted); }
  .scale-animal { color: var(--paper); }
  .ruler { position: relative; height: 2rem; }
  .ruler span { position: absolute; top: .4rem; translate: -50% 0; font: 500 .72rem var(--label); color: var(--muted); letter-spacing: .08em; }
  .ruler span:first-child { translate: 0 0; }
  .ruler span:last-child { translate: -100% 0; }
  .note { font-size: .8rem; color: var(--muted); margin: .8rem 0 0; }
  .maps { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .maps.single { grid-template-columns: minmax(0, 640px); }
  .maps figure { margin: 0; padding: .8rem; }
  .maps figcaption { text-align: center; margin-top: .4rem; }
  .pbdb { background: var(--wall); border: 1px solid var(--line); border-radius: 6px; padding: 1.5rem; }
  .pbdb-bar { position: relative; height: 34px; background: var(--wall-2); border-radius: 4px; }
  .pbdb-bar .period { position: absolute; top: 0; height: 22px; background: color-mix(in srgb, var(--pc) 70%, #000); border-radius: 4px; }
  .pbdb-bar .period i { font: 600 .68rem var(--label); letter-spacing: .1em; text-transform: uppercase; font-style: normal; color: #000c; padding: .2rem .5rem; display: block; white-space: nowrap; overflow: hidden; }
  .pbdb-bar .range { position: absolute; bottom: 3px; height: 6px; min-width: 6px; background: var(--brass); border-radius: 3px; }
  .pbdb-axis { display: flex; justify-content: space-between; margin: .3rem 0 1rem; }
  .sources ul { padding-left: 1.2rem; color: var(--muted); }
  .sources a { color: var(--brass); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 5rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  .pager a { text-decoration: none; display: grid; gap: .2rem; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 6px; transition: border-color .2s; }
  .pager a:hover { border-color: var(--brass); }
  .pager .right { text-align: right; }
  .pager strong { font: 400 1.4rem var(--serif); }
  .pager small { color: var(--muted); }
  @media (max-width: 900px) {
    .top, .maps { grid-template-columns: 1fr; }
    .main-ced { position: static; }
  }
</style>
