---
import Museum from '../layouts/Museum.astro';
import Silhouette from '../components/Silhouette.astro';
import { myths } from '../data/myths.js';
import { speciesById } from '../data/species.js';
import { href } from '../lib/site.js';
const VERDICT = { mito: 'Mito', realidad: 'Realidad', matizado: 'Depende' };
---
<Museum title="Mitos y evidencia" stamp="mitos" description="Lo que las películas dicen de los dinosaurios y lo que dicen los fósiles.">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Sala V · Mitos y evidencia</p>
      <h1>¿Mito<br /><em>o fósil?</em></h1>
      <p class="lead">Las películas y los documentales viejos dejaron ideas que la evidencia ya corrigió. Antes de voltear cada tarjeta, decide qué crees. Al final verás tu marcador.</p>
      <p class="score label" aria-live="polite">Aciertos: <b id="hits">0</b> de <b id="done">0</b> · {myths.length} tarjetas</p>
    </div>
  </section>

  <section class="wrap myths">
    {myths.map((m, i) => {
      const s = speciesById[m.species];
      return (
        <article class={`myth v-${m.verdict}`} data-verdict={m.verdict}>
          <div class="front">
            <span class="label">Tarjeta {String(i + 1).padStart(2, '0')}</span>
            {s && <Silhouette id={s.id} class="myth-sil" />}
            <h2>«{m.claim}»</h2>
            <div class="guess" role="group" aria-label="Tu respuesta">
              <button type="button" class="chip" data-guess="realidad">Es real</button>
              <button type="button" class="chip" data-guess="mito">Es mito</button>
              <button type="button" class="chip" data-guess="matizado">Depende</button>
            </div>
          </div>
          <div class="back" hidden>
            <span class="verdict">{VERDICT[m.verdict]}</span>
            <p class="you label"></p>
            <p>{m.answer}</p>
            {s && <a href={href(s)} class="label">Ver la pieza: {s.name} →</a>}
          </div>
        </article>
      );
    })}
  </section>
</Museum>

<script>
  let hits = 0, done = 0;
  document.querySelectorAll<HTMLElement>('.myth').forEach((card) => {
    card.querySelectorAll<HTMLButtonElement>('[data-guess]').forEach((b) => b.addEventListener('click', () => {
      const ok = b.dataset.guess === card.dataset.verdict;
      done++; if (ok) hits++;
      card.classList.add('flipped', ok ? 'ok' : 'no');
      card.querySelector<HTMLElement>('.front .guess')!.remove();
      const back = card.querySelector<HTMLElement>('.back')!;
      back.hidden = false;
      back.querySelector('.you')!.textContent = ok ? '✓ Acertaste' : '✗ No esta vez';
      document.getElementById('hits')!.textContent = String(hits);
      document.getElementById('done')!.textContent = String(done);
      const all = document.querySelectorAll('.myth').length;
      if (done === all) localStorage.setItem('paleopulso:mitos', JSON.stringify({ hits, all }));
    }, { once: true }));
  });
</script>

<style>
  .score b { color: var(--brass); font-size: 1.1rem; }
  .myths { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 1.2rem; padding-bottom: 6rem; }
  .myth { background: var(--wall); border: 1px solid var(--line); border-radius: 6px; padding: 1.6rem; display: grid; gap: 1rem; align-content: start; position: relative; overflow: hidden; transition: border-color .3s, background .3s; }
  .myth :global(.myth-sil) { position: absolute; right: -6%; top: 1rem; width: 52%; max-height: 120px; color: var(--paper); opacity: .07; }
  .myth h2 { font-size: 1.55rem; line-height: 1.2; position: relative; }
  .guess { display: flex; gap: .4rem; flex-wrap: wrap; }
  .myth.flipped { background: var(--paper); color: var(--ink); }
  .myth.flipped h2 { color: var(--ink); font-size: 1.25rem; }
  .myth.flipped .label { color: var(--ink-soft); }
  .myth.ok { border-color: var(--moss); } .myth.no { border-color: var(--rust); }
  .back p { margin: 0 0 .7rem; color: #3d3226; }
  .back a { color: var(--ink); }
  .verdict { display: inline-block; font: 400 1.9rem var(--sc); padding: 0 .2rem; margin-bottom: .2rem; }
  .v-mito .verdict { color: #a2391c; } .v-realidad .verdict { color: #4e6b33; } .v-matizado .verdict { color: #355e66; }
  .myth.ok .you { color: #4e6b33 !important; } .myth.no .you { color: #a2391c !important; }
</style>
